    {
      "id": "37",
      "type": "details",
      "attributes": {
        "key": "documentation",
        "value": "Determines the precise type of the Pseudostate and can be one of: entryPoint, exitPoint, initial, deepHistory, shallowHistory, join, fork, junction, terminate or choice."
      }
    },
    {
      "id": "38",
      "type": "eClassifiers",
