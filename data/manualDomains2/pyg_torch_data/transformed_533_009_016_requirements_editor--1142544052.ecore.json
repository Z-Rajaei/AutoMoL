    {
      "id": "11",
      "type": "details",
      "attributes": {
        "key": "differentResponsible",
        "value": "self.requirementOwnedBy.personOwnsCategory->forAll(c | not c.requirement->includes(self))"
      }
    },
    {
      "id": "12",
      "type": "details",
      "attributes": {
        "key": "notItself",
        "value": "self.dependencySource->select(oclIsTypeOf(Requires))->forAll(requires: Dependency | findLeafNodes(requires.oclAsType(Requires).argument)->forAll(ra: RequirementArgument | ra.requirement <> self))"
      }
    },
    {
      "id": "13",
      "type": "eOperations",
