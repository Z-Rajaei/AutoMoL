    {
      "id": "17",
      "type": "details",
      "attributes": {
        "key": "documentation",
        "value": "The conditions on transitions are referenced as the \"guard\". A \"guard\" is placed on the transition expression and its evaluation is mandatory for the state change."
      }
    },
    {
      "id": "18",
      "type": "eStructuralFeatures",
