    {
      "id": "20",
      "type": "details",
      "attributes": {
        "key": "OutgoingDontAddUpToOne",
        "value": "Tuple {\n\tmessage : String = 'Probability of all outgoing transitions must be 1.0.',\n\tstatus : Boolean = \n            self.outgoing->size() = 0 or (self.outgoing.prob->sum() - 1.0).abs()  < 0.000001\n}.status"
      }
    },
    {
      "id": "21",
      "type": "details",
      "attributes": {
        "key": "NonDeterministic",
        "value": "Tuple {\n\tmessage : String = 'There must not be any nondeterminism. Please union transitions to the same target.',\n\tstatus : Boolean = \n\t\t\tself.outgoing.to->asSet()->size() = self.outgoing->size()\n}.status"
      }
    },
    {
      "id": "22",
      "type": "details",
      "attributes": {
        "key": "NoDuplicateLabels",
        "value": "Tuple {\n\tmessage : String = 'Labels must be unique per state.',\n\tstatus : Boolean = \n\t\t\tself.labels.name->asSet()->size() = self.labels->size()\n}.status"
      }
    },
    {
      "id": "23",
      "type": "details",
      "attributes": {
        "key": "ExitRateGreaterZero",
        "value": "Tuple {\n\tmessage : String = 'Exit rate must be greater than 0.',\n\tstatus : Boolean = \n\t\t    exitRate > 0.0 or self.outgoing->size() = 0\n}.status"
      }
    },
