    {
      "id": "31",
      "type": "details",
      "attributes": {
        "key": "body",
        "value": "// Get the Transition EClass\r\nEPackage ePackage = eObject.eClass().getEPackage();\r\n\r\n// Get the PnObject EClass\r\nEClass pnObjectEClass = (EClass) ePackage.getEClassifier(PnmlcoremodelPackage.eINSTANCE.getPnObject().getName());\r\n\r\ntry {\r\n\tif (pnObjectEClass.isSuperTypeOf(eObject.eClass())) {\r\n\t\treturn true;\r\n\t}\r\n} catch (NullPointerException e) {\r\n}\r\nreturn false;"
      }
    },
    {
      "id": "32",
      "type": "eParameters",
      "attributes": {
        "name": "eObject",
        "eType": "ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EObject"
      }
    },
    {
      "id": "33",
      "type": "eOperations",
