      "attributes": {
        "source": "http://www.eclipse.org/emf/2002/GenModel"
      }
    },
    {
      "id": "35",
      "type": "details",
      "attributes": {
        "key": "body",
        "value": "// Get the Transition EClass\r\nEPackage ePackage = eObject.eClass().getEPackage();\r\n\r\n// Get the Transition EClass\r\nEClass transitionEClass = (EClass) ePackage.getEClassifier(PnmlcoremodelPackage.eINSTANCE.getTransition().getName());\r\n\r\ntry {\r\n\tif (transitionEClass.isInstance(eObject)) {\r\n\t\treturn true;\r\n\t}\r\n} catch (NullPointerException e) {\r\n}\r\nreturn false;"
      }
    },
    {
      "id": "36",
      "type": "eParameters",
      "attributes": {
