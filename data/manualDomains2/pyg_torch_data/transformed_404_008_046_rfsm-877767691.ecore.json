    {
      "id": "35",
      "type": "details",
      "attributes": {
        "key": "constraints",
        "value": "transitionOwner legalBoundaryCrossing maxOneTransitionFromInitialConnector noGuardFromInitialConnector"
      }
    },
    {
      "id": "36",
      "type": "eAnnotations",
      "attributes": {
        "source": "http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"
      }
    },
    {
      "id": "37",
      "type": "details",
      "attributes": {
        "key": "transitionOwner",
        "value": "let lca : State = LCA(self.source, self.target) in self.owner = lca or isAncestor(self.owner, lca)"
      }
    },
    {
      "id": "38",
      "type": "details",
      "attributes": {
        "key": "legalBoundaryCrossing",
        "value": "(self.target.parent <> self.source) and isAncestor(self.target.parent, self.source)"
      }
    },
    {
      "id": "39",
      "type": "details",
      "attributes": {
        "key": "maxOneTransitionFromInitialConnector",
        "value": "(self.source.oclIsTypeOf(Connector) and self.source.name='initial') implies (Transition.allInstances()->select(t | t.source = self.source)->size()) <= 1"
      }
    },
    {
      "id": "40",
      "type": "details",
      "attributes": {
        "key": "noGuardFromInitialConnector",
        "value": "(self.source.oclIsTypeOf(Connector) and self.source.name='initial') implies guard.oclIsUndefined()"
      }
    },
    {
      "id": "41",
      "type": "eOperations",
      "attributes": {
        "name": "isAncestor",
        "unique": "false",
        "eType": "ecore:EDataType ../../org.eclipse.emf.ecore/model/Ecore.ecore#//EBooleanObject"
      }
    },
    {
      "id": "42",
      "type": "eAnnotations",
      "attributes": {
        "source": "http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"
      }
    },
    {
      "id": "43",
      "type": "details",
      "attributes": {
        "key": "body",
        "value": "if (one = two) \n\t\t\t\t\tthen true\n\t\t\t\telse\n\t\t\t\t\tif (two.parent.oclIsUndefined ())\n\t\t\t\t\t\tthen false\n\t\t\t\t\telse \n\t\t\t\t\t\tif (two.parent = one)\n\t\t\t\t\t\t\tthen true\n\t\t\t\t\t\telse \n\t\t\t\t\t\t\tisAncestor(one, two.parent)\n\t\t\t\t\t\tendif\n\t\t\t\t\tendif\n\t\t\t\tendif"
      }
    },
    {
      "id": "44",
      "type": "eParameters",
      "attributes": {
        "name": "one",
        "unique": "false",
        "eType": "#//Node"
      }
    },
    {
      "id": "45",
      "type": "eParameters",
      "attributes": {
        "name": "two",
        "unique": "false",
        "eType": "#//Node"
      }
    },
    {
      "id": "46",
      "type": "eOperations",
      "attributes": {
        "name": "LCA",
        "unique": "false",
        "eType": "#//State"
      }
    },
    {
      "id": "47",
      "type": "eAnnotations",
      "attributes": {
        "source": "http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"
      }
    },
    {
      "id": "48",
      "type": "details",
      "attributes": {
        "key": "body",
        "value": "if isAncestor(one, two) and one.oclIsTypeOf(State)\n\t\t\t\t\tthen one.oclAsType(State)\n\t\t\t\telse \n\t\t\t\t\tif isAncestor(two, one) and two.oclIsTypeOf(State)\n\t\t\t\t\t\tthen two.oclAsType(State)\n\t\t\t\t\telse\n\t\t\t\t\t\tLCA(one.parent,two.parent)\n\t\t\t\t\tendif\n\t\t\t\tendif"
      }
    },
    {
      "id": "49",
      "type": "eParameters",
      "attributes": {
        "name": "one",
        "unique": "false",
        "eType": "#//Node"
