      }
    },
    {
      "id": "22",
      "type": "details",
      "attributes": {
        "key": "defineInitialConnectorWhenComposite",
        "value": "self.subnodes->size() > 0 and Transition.allInstances()->exists(t | t.target=self) implies self.subnodes->select(c | c.oclIsTypeOf(Connector) and c.name='initial')->size() = 1"
      }
    },
    {
      "id": "23",
      "type": "details",
      "attributes": {
        "key": "defineMaxOneInitialConnector",
        "value": "self.subnodes->size() > 0 implies (self.subnodes->select(c | c.oclIsTypeOf(Connector) and c.name='initial')->size() <= 1)"
      }
    },
    {
      "id": "24",
      "type": "details",
      "attributes": {
        "key": "onlyLeafStatesHaveDoo",
        "value": "(not self.doo.oclIsUndefined()) implies (self.subnodes->size() = 0)"
      }
    },
