      "id": "89",
      "type": "eStructuralFeatures",
      "attributes": {
        "type": "ecore:EAttribute",
        "name": "scope",
        "eType": "#//ResultSetScopeType",
        "defaultValueLiteral": "EXECUTION",
        "unsettable": "true"
      }
    },
    {
      "id": "90",
      "type": "eAnnotations",
      "attributes": {
        "source": "http://www.eclipse.org/emf/2002/GenModel"
      }
    },
    {
      "id": "91",
      "type": "details",
      "attributes": {
        "key": "documentation",
        "value": "\n    \t\t\t\tThe scope on which the resultSet will be stored. The scope can be on a EXECUTION or\n    \t\t\t\ton a APPLICATION level. On a EXECUTION level the query is executed every time on the selected element.\n    \t\t\t\tOn a APPLICATION level the query is only executed once for the\n    \t\t\t\twhole Smooks instance until the resultSet expires. With the 'timeToLive' attribute the expire time\n    \t\t\t\tcan be configured. After the resultSet is expired the query will be executed again.\n    \t\t\t"
      }
    },
    {
      "id": "92",
      "type": "eAnnotations",
      "attributes": {
        "source": "http:///org/eclipse/emf/ecore/util/ExtendedMetaData"
