      }
    },
    {
      "id": "97",
      "type": "details",
      "attributes": {
        "key": "documentation",
        "value": "\n    \t\t\t\tIf the 'scope' attribute is set to APPLICATION this attribute determines the expire time\n    \t\t\t\tin milliseconds of the resultSet. After the resultSet is expired the query will be executed again.\n    \t\t\t"
