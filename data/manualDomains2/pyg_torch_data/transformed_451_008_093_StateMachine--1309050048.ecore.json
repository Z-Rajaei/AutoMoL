    {
      "id": "28",
      "type": "details",
      "attributes": {
        "key": "constraints",
        "value": "initialStateInComposite uniqueCompositeName"
      }
    },
    {
      "id": "29",
      "type": "eAnnotations",
      "attributes": {
        "source": "http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"
      }
    },
    {
      "id": "30",
      "type": "details",
      "attributes": {
        "key": "initialStateInComposite",
        "value": "self.states->includes(self.initialState.referencedState)"
      }
    },
    {
      "id": "31",
      "type": "details",
      "attributes": {
        "key": "uniqueCompositeName",
        "value": "self.states->forAll(s1 : State | self.states->forAll(s2 : State | s1.name = s2.name implies s1 = s2))"
      }
    },
    {
      "id": "32",
      "type": "eOperations",
      "attributes": {
        "name": "activeSubTree",
        "lowerBound": "1",
        "eType": "ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
      }
    },
    {
      "id": "33",
      "type": "eAnnotations",
      "attributes": {
        "source": "http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"
      }
    },
    {
      "id": "34",
      "type": "details",
      "attributes": {
        "key": "body",
        "value": "self.states->select(s : State | s.isActive)->size() = 1 and self.states->select(s : State | s.oclIsTypeOf(CompositeState))->forAll(s : State | if s.isActive then s.oclAsType(CompositeState).activeSubTree() else s.oclAsType(CompositeState).unactiveSubTree() endif)"
      }
    },
    {
      "id": "35",
      "type": "eOperations",
      "attributes": {
        "name": "unactiveSubTree",
        "lowerBound": "1",
        "eType": "ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"
      }
    },
    {
      "id": "36",
      "type": "eAnnotations",
      "attributes": {
        "source": "http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot"
      }
    },
    {
      "id": "37",
      "type": "details",
      "attributes": {
        "key": "body",
        "value": "self.states->forAll(s : State | not s.isActive) and self.states->select(s : State | s.oclIsTypeOf(CompositeState))->forAll(s : State | s.oclAsType(CompositeState).unactiveSubTree())"
      }
    },
